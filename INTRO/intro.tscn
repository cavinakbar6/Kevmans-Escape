[gd_scene format=3]

[ext_resource type="Script" path="res://INTRO/intro.gd" id="1_scr"]

[node name="IntroScene" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_scr")

[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.02, 0.05, 1)

[node name="IntroContainer" type="Control" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="ImageDisplay" type="TextureRect" parent="IntroContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
expand_mode = 1
stretch_mode = 5

[node name="SkipHint" type="Label" parent="IntroContainer"]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -200.0
offset_top = -40.0
offset_right = 200.0
grow_horizontal = 2
grow_vertical = 0
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 0.6)
theme_override_font_sizes/font_size = 14
text = "Press SPACE / ENTER / ESC to skip"
horizontal_alignment = 1

[node name="BlackOverlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)

[node name="SkipDialog" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -120.0
offset_right = 220.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="DialogTitle" type="Label" parent="SkipDialog"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 36
text = "GAME INTRO"
horizontal_alignment = 1

[node name="DialogQuestion" type="Label" parent="SkipDialog"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)
theme_override_font_sizes/font_size = 20
text = "Do you want to watch the intro?"
horizontal_alignment = 1

[node name="WatchButton" type="Button" parent="SkipDialog"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 22
text = "WATCH INTRO"

[node name="SkipButton" type="Button" parent="SkipDialog"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
theme_override_colors/font_hover_color = Color(1, 0.3, 0.3, 1)
theme_override_font_sizes/font_size = 22
text = "SKIP INTRO"

[connection signal="pressed" from="SkipDialog/WatchButton" to="." method="_on_watch_intro_pressed"]
[connection signal="pressed" from="SkipDialog/SkipButton" to="." method="_on_skip_intro_pressed"]

[node name="IntroAudio" type="AudioStreamPlayer" parent="."]
